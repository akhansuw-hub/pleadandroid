<?xml version="1.0" encoding="utf-8"?>
<!-- The court-session notification's content (iOS PleadActivityLockScreenView, the Live Activity banner): cream card,
     burgundy accent bar, pixel judge, deep-wine headline (two lines max), "Case #021", cocoa detail (one line), and the
     countdown ("Plea due in / 23:59:10") or the pixel gavel. Filled from push/CourtSessionNotification.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/court_session_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="20dp"
    android:paddingTop="10dp"
    android:paddingEnd="12dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/court_session_judge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:importantForAccessibility="no"
        android:scaleType="center" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/court_session_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:maxLines="2"
            android:textColor="#FF541F2C"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/court_session_case"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF7C3042"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/court_session_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#FF3B2425"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/court_session_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/court_session_countdown_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="#CC3B2425"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/court_session_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:maxLines="1"
            android:textColor="#FF7C3042"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/court_session_gavel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:scaleType="center" />
</LinearLayout>
