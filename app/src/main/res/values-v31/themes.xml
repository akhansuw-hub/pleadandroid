<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Plead" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:colorAccent">@color/accent_color</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- System splash: the iOS launch screen is plain LaunchBackground; the icon sits on the same cream. -->
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>
</resources>
