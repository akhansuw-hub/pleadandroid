<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light-only (iOS forces .light). Window background = LaunchBackground (cream) so nothing flashes white. -->
    <style name="Theme.Plead" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/launch_background</item>
        <item name="android:colorAccent">@color/accent_color</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
